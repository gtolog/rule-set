# 局域网后缀（注意 QX 的 HOST-SUFFIX 前面不加点）
HOST-SUFFIX, lan
HOST-SUFFIX, local
HOST-SUFFIX, home.arpa
HOST-SUFFIX, service.arpa

# IPv4 反向解析网段
HOST-WILDCARD, *.10.in-addr.arpa
HOST-WILDCARD, *.168.192.in-addr.arpa
HOST-WILDCARD, *.0.0.127.in-addr.arpa
HOST-WILDCARD, *.254.169.in-addr.arpa

# 172.16.0.0/12 (172.16 - 172.31，不能写成 *.1?.172.*，否则会误伤 172.10-172.15 公网段)
HOST-WILDCARD, *.16.172.in-addr.arpa
HOST-WILDCARD, *.17.172.in-addr.arpa
HOST-WILDCARD, *.18.172.in-addr.arpa
HOST-WILDCARD, *.19.172.in-addr.arpa
HOST-WILDCARD, *.20.172.in-addr.arpa
HOST-WILDCARD, *.21.172.in-addr.arpa
HOST-WILDCARD, *.22.172.in-addr.arpa
HOST-WILDCARD, *.23.172.in-addr.arpa
HOST-WILDCARD, *.24.172.in-addr.arpa
HOST-WILDCARD, *.25.172.in-addr.arpa
HOST-WILDCARD, *.26.172.in-addr.arpa
HOST-WILDCARD, *.27.172.in-addr.arpa
HOST-WILDCARD, *.28.172.in-addr.arpa
HOST-WILDCARD, *.29.172.in-addr.arpa
HOST-WILDCARD, *.30.172.in-addr.arpa
HOST-WILDCARD, *.31.172.in-addr.arpa

# IPv6 反向解析网段 (ULA fc00::/7 与 Link-Local fe80::/16)
# HOST-WILDCARD, *.c.f.ip6.arpa
# HOST-WILDCARD, *.d.f.ip6.arpa
# HOST-WILDCARD, *.0.8.e.f.ip6.arpa
HOST-WILDCARD, *.ip6.arpa
